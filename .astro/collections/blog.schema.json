{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "pubDate": {
      "type": "string",
      "format": "date-time"
    },
    "author": {
      "type": "string"
    },
    "image": {
      "type": "string"
    },
    "category": {
      "type": "string"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "draft": {
      "default": false,
      "type": "boolean"
    },
    "updatedDate": {
      "type": "string",
      "format": "date-time"
    },
    "ogImage": {
      "type": "string"
    },
    "canonicalUrl": {
      "type": "string"
    },
    "jsonLd": {
      "anyOf": [
        {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {}
        },
        {
          "type": "array",
          "items": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {}
          }
        }
      ]
    },
    "imageAlt": {
      "type": "string"
    },
    "schemaType": {
      "type": "string"
    },
    "schemaData": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {}
    },
    "featured": {
      "default": false,
      "type": "boolean"
    },
    "series": {
      "type": "string"
    },
    "seriesOrder": {
      "type": "number"
    },
    "toc": {
      "default": true,
      "type": "boolean"
    },
    "readingTime": {
      "type": "string"
    },
    "$schema": {
      "type": "string"
    }
  },
  "required": [
    "title",
    "description",
    "pubDate"
  ]
}